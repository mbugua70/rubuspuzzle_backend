PORT=5000

NODE_ENV=development

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/picture-puzzle
# MongoDB Atlas (SRV):
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/picture-puzzle?appName=<app-name>

# Comma-separated list of allowed origins. This backend serves two
# unrelated frontends, so all of their origins must be listed here:
#  - the rubus_puzzle facilitator/display apps
#  - the online_rubuspuzzle self-service kiosk app (fixed dev port 5176,
#    see its vite.config.js; deployed at https://online-rubus-puzzle.vercel.app)
# The deployed server (mindmillrubuspuzzle.igurukenya.app) must have its
# CLIENT_URL env var set on its host to include ALL of these production
# origins, not just the example below - this file is not read in prod.
# e.g. in production:
# CLIENT_URL=https://facilitator.example.com,https://display.example.com,https://online-rubus-puzzle.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:5176

LOG_LEVEL=info

# Signs admin dashboard JWTs (see src/utils/jwt.ts). Generate a real random
# value for this in every environment, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
