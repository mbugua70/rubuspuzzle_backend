PORT=5000

NODE_ENV=development

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/picture-puzzle
# MongoDB Atlas (SRV):
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/picture-puzzle?appName=<app-name>

# Comma-separated list if the facilitator/display frontends are on
# different origins, e.g.:
# CLIENT_URL=https://facilitator.example.com,https://display.example.com
CLIENT_URL=http://localhost:5173

LOG_LEVEL=info
